{
  "name": "coros-sync",
  "productName": "COROS Sync",
  "private": true,
  "version": "0.1.0",
  "description": "Sync Spotify playlists to a COROS watch.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run package -- --mac",
    "package:win": "npm run package -- --win --x64",
    "package:linux": "npm run package -- --linux --x64",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.jacob.corossync",
    "productName": "COROS Sync",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "AudioVideo",
      "target": ["AppImage", "tar.gz"]
    }
  }
}
